# LinkedIn Studio config. Restart after editing:  launchctl kickstart -k gui/$(id -u)/com.manav.linkedin-studio.web

# --- Gmail for recruiter outreach (SMTP send + IMAP reply detection) ---
# Create an App Password: myaccount.google.com -> Security -> 2-Step Verification (must be ON) -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
FROM_NAME=

# --- Outreach limits ---
OUTREACH_NEW_PER_DAY=20
OUTREACH_TOTAL_CAP=45
SEND_MIN_GAP_MIN=2
SEND_MAX_GAP_MIN=5
SEND_WINDOW_START=9.5
SEND_WINDOW_END=18
MAX_BOUNCE_RATE=0.03
TARGET_ROLES=SDE-2 / Backend Engineer / AI Engineer
RESUME_PATH=

# --- Posts ---
LINKEDIN_HANDLE=
# Shown under your name on explainer videos
LINKEDIN_ROLE=Backend SDE
# First line and last line added to every post when it goes out (leave empty to skip). Keep the quotes: an unquoted # is read as a comment.
POST_HEADER="🚀 Immediate Joiner | Open to SDE/FDE Opportunities"
POST_HASHTAGS="#OpenToWork #ImmediateJoiner #SystemDesign #Tech #SoftwareEngineering #Hiring"
OPEN_TO_WORK_TAG=false

# --- LinkedIn API (direct posting) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
