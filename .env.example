# LinkedIn Studio config. Restart after editing:  launchctl kickstart -k gui/$(id -u)/com.linkedin-studio.web

# --- Gmail for recruiter outreach (SMTP send + IMAP reply detection) ---
# Create an App Password: myaccount.google.com -> Security -> 2-Step Verification (must be ON) -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# your name, as it appears on emails
FROM_NAME=

# --- Outreach limits ---
OUTREACH_NEW_PER_DAY=20
OUTREACH_TOTAL_CAP=45
SEND_MIN_GAP_MIN=2
SEND_MAX_GAP_MIN=5
SEND_WINDOW_START=9.5
SEND_WINDOW_END=18
MAX_BOUNCE_RATE=0.03
TARGET_ROLES=SDE-2 / Backend Engineer / AI Engineer
# default: data/resume.pdf (attached under this file name)
RESUME_PATH=
# Your own employer's domains, never emailed (comma-separated), e.g. acme.com,acme.in
EXCLUDE_DOMAINS=

# --- Posts ---
# your name, shown on carousels and diagrams
LINKEDIN_HANDLE=
OPEN_TO_WORK_TAG=false

# --- LinkedIn API (direct posting) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Recruiter outreach details (the rest of your profile lives in ~/.claude/linkedin/voice.md) ---
# optional, added under your email signature
CONTACT_PHONE=
# YYYY-MM of your first full-time job; emails say "2+ years" etc.
CAREER_START=

# --- Auto-post (12:00 daily: posts the next approved draft, one per day, in approval order) ---
# 0 turns it off
AUTO_POST=1
# if the Mac was asleep at noon, don't post after this hour
AUTO_POST_UNTIL=18
